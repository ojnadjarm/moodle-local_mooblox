{{!
    @template local_mooblox/favicon

    Mooblox favicon link for the world and hub pages.

    Context variables required for this template:
    * href - URL of the favicon image

    Example context (json):
    {
        "href": "https://example.com/theme/image.php/boost/local_mooblox/1/favicon"
    }
}}
<link rel="icon" type="image/svg+xml" href="{{href}}">
